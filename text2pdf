#!/usr/bin/env python3
"""Convert text files to an A4 PDF using an embedded IPA Gothic TrueType font."""

import argparse
import getpass
import math
import os
import sys
import tempfile
from datetime import datetime

from reportlab.lib import colors
from reportlab.lib.pagesizes import A4, landscape
from reportlab.lib.units import mm
from reportlab.pdfbase import pdfmetrics
from reportlab.pdfbase.ttfonts import TTFont
from reportlab.pdfgen import canvas

FONT_NAME = "IPAGothic"
IPA_GOTHIC_FILENAME = "ipag.ttf"
# Same directories fontconfig scans. Subdirectories are included.
FONT_SEARCH_DIRS = (
    "/usr/share/fonts",
    "/usr/local/share/fonts",
    "/usr/share/X11/fonts",
    os.path.expanduser("~/.local/share/fonts"),
    os.path.expanduser("~/.fonts"),
)
DEFAULT_ENCODING = "auto"
DEFAULT_TAB_SIZE = 8
UTF8_BOM = b"\xef\xbb\xbf"
# Auto-detection tries these in order. euc_jp is accepted only when named
# explicitly; euc_jis_2004 already decodes ordinary EUC-JP text.
AUTO_ENCODINGS = ("euc_jis_2004", "utf-8", "cp932")

# Canonical codec names. Keys are the normalized spellings we accept.
_ENCODING_ALIASES = {
    "auto": "auto",
    "euc-jp": "euc_jp",
    "euc-jis-2004": "euc_jis_2004",
    "utf-8": "utf-8",
    "utf8": "utf-8",
    "cp932": "cp932",
    "cp-932": "cp932",
}
_SUPPORTED_ENCODINGS = "auto, euc_jp, euc_jis_2004, utf-8, cp932"

_WIDTH_EPSILON = 1e-6


class ConversionError(Exception):
    """Recoverable conversion failure with a process exit code."""

    def __init__(self, message, exit_code=1):
        super().__init__(message)
        self.exit_code = exit_code


def normalize_encoding(name):
    """Return a Python codec name, or raise ConversionError for an unknown one."""
    if not isinstance(name, str) or not name.strip():
        raise ConversionError(
            "Error: Unsupported encoding: {!r}. Supported encodings: "
            "{}.".format(name, _SUPPORTED_ENCODINGS),
            2,
        )
    folded = name.strip().lower().replace("_", "-")
    codec = _ENCODING_ALIASES.get(folded)
    if codec is None:
        raise ConversionError(
            "Error: Unsupported encoding: {!r}. Supported encodings: "
            "{}.".format(name, _SUPPORTED_ENCODINGS),
            2,
        )
    return codec


def same_file_path(left, right):
    """Return True when two paths name the same file after normalization."""
    if os.path.abspath(os.path.normpath(left)) == os.path.abspath(os.path.normpath(right)):
        return True
    try:
        return os.path.samefile(left, right)
    except OSError:
        return False


def select_decoded(successes):
    """Pick the highest-priority successful decode.

    ``successes`` is a list of ``(codec, text)`` already ordered by
    ``AUTO_ENCODINGS``. Codecs whose text differs from the selected text are
    returned as ambiguous. Identical text does not count as ambiguous.
    """
    selected_codec, selected_text = successes[0]
    ambiguous = [codec for codec, text in successes[1:] if text != selected_text]
    return selected_codec, selected_text, ambiguous


def _read_binary(path):
    try:
        with open(path, "rb") as handle:
            return handle.read()
    except FileNotFoundError:
        raise ConversionError("Error: File not found: {}".format(path), 1)
    except IsADirectoryError:
        raise ConversionError("Error: Input path is a directory: {}".format(path), 1)
    except OSError as exc:
        raise ConversionError("Error reading file: {}".format(exc), 1)


def _decode_error(path, source, codec, exc, offset_base=0):
    offset = exc.start + offset_base
    line_no = source[:offset].count(b"\n") + 1
    raise ConversionError(
        "Error: Could not decode {path} as {codec} at byte {offset} "
        "(line {line}): {reason}".format(
            path=path,
            codec=codec,
            offset=offset,
            line=line_no,
            reason=exc.reason,
        ),
        1,
    )


def decode_strict(data, codec, path, source=None, offset_base=0):
    """Decode ``data`` with ``codec`` and raise ConversionError on failure."""
    if source is None:
        source = data
    try:
        return data.decode(codec)
    except UnicodeDecodeError as exc:
        _decode_error(path, source, codec, exc, offset_base)


def detect_encoding(data, path):
    """Detect an encoding and return ``(text, codec, ambiguous_codecs)``.

    A UTF-8 BOM wins immediately. Invalid UTF-8 after a BOM is an error.
    ASCII, including an empty file, is UTF-8. Otherwise each auto candidate
    is decoded strictly and the priority order in ``AUTO_ENCODINGS`` applies.
    """
    if data.startswith(UTF8_BOM):
        text = decode_strict(
            data[len(UTF8_BOM):],
            "utf-8",
            path,
            source=data,
            offset_base=len(UTF8_BOM),
        )
        return text, "utf-8", []
    if data.isascii():
        return data.decode("utf-8"), "utf-8", []

    successes = []
    for codec in AUTO_ENCODINGS:
        try:
            successes.append((codec, data.decode(codec)))
        except UnicodeDecodeError:
            continue
    if not successes:
        raise ConversionError(
            "Error: Could not decode {path} as euc_jis_2004, utf-8, or cp932.".format(path=path),
            1,
        )
    codec, text, ambiguous = select_decoded(successes)
    return text, codec, ambiguous


def format_ambiguous_warning(selected, others):
    return (
        "Warning: Ambiguous encoding detected.\n"
        "Selected: {selected}\n"
        "Other possible encodings: {others}\n"
        "Use --encoding to specify the correct encoding.".format(
            selected=selected,
            others=", ".join(others),
        )
    )


def report_encoding(encoding, selected, ambiguous):
    """Print the auto-detection result. Explicit encodings stay quiet."""
    if normalize_encoding(encoding) == "auto":
        print("Detected encoding: {}".format(selected))
    if ambiguous:
        print(format_ambiguous_warning(selected, ambiguous), file=sys.stderr)


def load_text(path, encoding):
    """Read ``path`` once and return ``(lines, selected_codec, ambiguous)``."""
    codec = normalize_encoding(encoding)
    data = _read_binary(path)
    if codec == "auto":
        text, selected, ambiguous = detect_encoding(data, path)
    else:
        text = decode_strict(data, codec, path)
        selected = codec
        ambiguous = []
    return text.splitlines(), selected, ambiguous


def read_text_file(path, encoding):
    """Read a text file and return lines without line endings.

    Decode errors include the file name, byte offset, line number, and reason.
    """
    lines, _selected, _ambiguous = load_text(path, encoding)
    return lines


def find_ipa_gothic(search_dirs=None):
    """Return the first ipag.ttf under the standard font directories.

    ``search_dirs`` is tried in order. Each directory's subdirectories are
    searched. Only a file named ipag.ttf matches, ignoring case.
    """
    roots = FONT_SEARCH_DIRS if search_dirs is None else search_dirs
    for root in roots:
        if not os.path.isdir(root):
            continue
        for dirpath, dirnames, filenames in os.walk(root):
            dirnames.sort()
            for name in sorted(filenames):
                if name.lower() == IPA_GOTHIC_FILENAME:
                    return os.path.join(dirpath, name)
    raise ConversionError(
        "Error: Cannot run because IPA Gothic (ipag.ttf) is not installed. "
        "Place ipag.ttf in /usr/share/fonts/ipa-gothic/ or another standard "
        "font directory, or pass --font-path.",
        1,
    )


def register_ipa_gothic(font_path):
    """Register a TrueType font under the name IPAGothic so it is embedded."""
    path = os.path.abspath(os.path.expanduser(font_path))
    if not os.path.isfile(path):
        raise ConversionError("Error: Font file not found: {}".format(path), 1)

    existing = pdfmetrics._fonts.get(FONT_NAME)
    if existing is not None:
        existing_path = getattr(getattr(existing, "face", None), "filename", None)
        if existing_path and os.path.abspath(existing_path) == path:
            return path
        face_name = getattr(getattr(existing, "face", None), "name", None)
        pdfmetrics._fonts.pop(FONT_NAME, None)
        if face_name is not None:
            pdfmetrics._dynFaceNames.pop(face_name, None)

    try:
        pdfmetrics.registerFont(TTFont(FONT_NAME, path))
    except Exception as exc:
        raise ConversionError(
            "Error: Could not register font {}: {}".format(path, exc),
            1,
        )
    return path


def fit_text(text, font_name, font_size, max_width):
    """Truncate text with an ellipsis so it is no wider than max_width."""
    if max_width <= 0:
        return ""
    if pdfmetrics.stringWidth(text, font_name, font_size) <= max_width:
        return text
    ellipsis = "..."
    ellipsis_width = pdfmetrics.stringWidth(ellipsis, font_name, font_size)
    if ellipsis_width > max_width:
        return ""
    best = ellipsis
    low = 0
    high = len(text)
    while low <= high:
        mid = (low + high) // 2
        candidate = text[:mid] + ellipsis
        if pdfmetrics.stringWidth(candidate, font_name, font_size) <= max_width:
            best = candidate
            low = mid + 1
        else:
            high = mid - 1
    return best


def layout_line(text, col_width, char_width, space_width, tab_size):
    """Split one logical line into visual lines of (x, text) segments.

    Tab stops are multiples of ``space_width * tab_size``, measured from the
    left edge of the current visual line. A tab advances to the next stop and
    is not emitted as a character. When the next glyph or tab stop does not
    fit, the visual line is closed and the remainder is placed on a new line
    whose drawing position starts at 0.
    """
    if tab_size < 1:
        raise ValueError("tab_size must be >= 1")
    if col_width <= 0:
        raise ValueError("col_width must be positive")
    if space_width <= 0:
        raise ValueError("space_width must be positive")

    pitch = space_width * tab_size
    lines = []
    segments = []
    x = 0.0
    buf = []
    buf_x = 0.0

    def flush():
        nonlocal buf
        if buf:
            segments.append((buf_x, "".join(buf)))
            buf = []

    def break_line():
        nonlocal segments, x
        flush()
        if segments or x > _WIDTH_EPSILON:
            lines.append(segments)
            segments = []
        x = 0.0

    for ch in text:
        if ch == "\t":
            flush()
            next_stop = (math.floor(x / pitch + 1e-9) + 1) * pitch
            if next_stop > col_width + _WIDTH_EPSILON:
                if x > _WIDTH_EPSILON or segments:
                    break_line()
                    next_stop = pitch
                if next_stop > col_width + _WIDTH_EPSILON:
                    # The tab stop itself is wider than the column.
                    continue
            x = next_stop
            continue

        width = char_width(ch)
        if width > col_width + _WIDTH_EPSILON:
            if buf or segments or x > _WIDTH_EPSILON:
                break_line()
            segments.append((0.0, ch))
            break_line()
            continue

        if x + width > col_width + _WIDTH_EPSILON and (buf or segments or x > _WIDTH_EPSILON):
            break_line()
        if not buf:
            buf_x = x
        buf.append(ch)
        x += width

    flush()
    if segments or not lines:
        lines.append(segments)
    return lines


class TextToPdfConverter:
    def __init__(
        self,
        font_size=10,
        layout="2up",
        font_path=None,
        tab_size=DEFAULT_TAB_SIZE,
        user=None,
    ):
        if layout not in ("1up", "2up"):
            raise ConversionError("Error: Unsupported layout: {!r}".format(layout), 2)
        if tab_size < 1:
            raise ConversionError(
                "Error: --tab-size must be an integer >= 1 (got {})".format(tab_size),
                2,
            )

        self.font_path = register_ipa_gothic(
            font_path if font_path else find_ipa_gothic()
        )
        self.font_name = FONT_NAME
        self.tab_size = tab_size
        self.user = getpass.getuser() if user is None else user
        self.layout = layout
        self.font_size = font_size

        if self.layout == "1up":
            self.page_width, self.page_height = A4
        else:
            self.page_width, self.page_height = landscape(A4)

        self.margin = 15 * mm
        self.column_gap = 10 * mm
        self.header_height = 6 * mm
        self.footer_height = 5 * mm
        self.padding_left = 6
        self.padding_right = 6

        self.body_width = self.page_width - (2 * self.margin)
        self.body_height = (
            self.page_height - (2 * self.margin) - self.header_height - self.footer_height
        )
        if self.layout == "1up":
            self.layout_col_width = self.body_width
        else:
            self.layout_col_width = (self.body_width - self.column_gap) / 2
        self.col_width = self.layout_col_width - (self.padding_left + self.padding_right)

        self.leading = font_size * 1.2 + 3
        self.lines_per_col = int(self.body_height / self.leading)
        if self.lines_per_col < 1:
            raise ConversionError("Error: Font size is too large for the page.", 1)
        if self.layout == "1up":
            self.lines_per_page = self.lines_per_col
        else:
            self.lines_per_page = self.lines_per_col * 2

        self._space_width = pdfmetrics.stringWidth(" ", self.font_name, self.font_size)
        if self._space_width <= 0:
            raise ConversionError(
                "Error: Font {} has no measurable space width.".format(self.font_path),
                1,
            )

    def char_width(self, ch):
        return pdfmetrics.stringWidth(ch, self.font_name, self.font_size)

    def layout_text_line(self, text):
        return layout_line(
            text,
            self.col_width,
            self.char_width,
            self._space_width,
            self.tab_size,
        )

    def convert(self, input_path, output_path, encoding=DEFAULT_ENCODING):
        if same_file_path(input_path, output_path):
            raise ConversionError(
                "Error: Output file is the same as the input file: {}".format(
                    os.path.abspath(os.path.normpath(output_path))
                ),
                1,
            )
        source_lines, selected, ambiguous = load_text(input_path, encoding)
        self.timestamp = datetime.fromtimestamp(os.path.getmtime(input_path))
        report_encoding(encoding, selected, ambiguous)
        visual_lines = []
        for line in source_lines:
            visual_lines.extend(self.layout_text_line(line))
        self._write_pdf(output_path, visual_lines, input_path)
        print("Successfully created {}".format(output_path))

    def _write_pdf(self, output_path, visual_lines, input_path):
        output_path = os.path.abspath(output_path)
        directory = os.path.dirname(output_path) or "."
        if not os.path.isdir(directory):
            raise ConversionError(
                "Error: Output directory not found: {}".format(directory),
                1,
            )
        if os.path.isdir(output_path):
            raise ConversionError(
                "Error: Output path is a directory: {}".format(output_path),
                1,
            )
        if os.path.exists(output_path):
            if not os.access(output_path, os.W_OK):
                raise ConversionError(
                    "Error: Cannot write output file: {}".format(output_path),
                    1,
                )
        elif not os.access(directory, os.W_OK):
            raise ConversionError(
                "Error: Cannot write output file: {}".format(output_path),
                1,
            )

        filename = os.path.basename(input_path)
        full_path = os.path.abspath(input_path)
        fd, tmp_path = tempfile.mkstemp(prefix=".text2pdf-", suffix=".pdf", dir=directory)
        os.close(fd)
        try:
            self._render(tmp_path, visual_lines, filename, full_path)
            # mkstemp creates the file as 0600. Match the process umask so the
            # PDF is as readable as a file opened directly by the user.
            umask = os.umask(0)
            os.umask(umask)
            os.chmod(tmp_path, 0o666 & ~umask)
            os.replace(tmp_path, output_path)
        except PermissionError:
            raise ConversionError(
                "Error: Cannot write output file: {}".format(output_path),
                1,
            )
        finally:
            if os.path.exists(tmp_path):
                try:
                    os.remove(tmp_path)
                except OSError:
                    pass

    def _render(self, pdf_path, lines, filename, full_path):
        c = canvas.Canvas(
            pdf_path,
            pagesize=(self.page_width, self.page_height),
            initialFontName=self.font_name,
            initialFontSize=self.font_size,
        )
        c.setTitle(filename)

        total_pages = int(math.ceil(len(lines) / float(self.lines_per_page))) if lines else 1
        if total_pages < 1:
            total_pages = 1

        current_line_idx = 0
        page_num = 1
        while current_line_idx < len(lines) or page_num == 1:
            self._draw_layout(c)
            self._draw_header(c, filename)
            self._draw_footer(c, page_num, total_pages, full_path)

            body_top = self.page_height - self.margin - self.header_height
            self._draw_column(
                c,
                lines,
                current_line_idx,
                self.lines_per_col,
                x=self.margin,
                y=body_top,
            )
            current_line_idx += self.lines_per_col

            if self.layout == "2up" and current_line_idx < len(lines):
                self._draw_column(
                    c,
                    lines,
                    current_line_idx,
                    self.lines_per_col,
                    x=self.margin + self.layout_col_width + self.column_gap,
                    y=body_top,
                )
                current_line_idx += self.lines_per_col

            c.showPage()
            page_num += 1
            if current_line_idx >= len(lines):
                break

        c.save()

    def _draw_layout(self, c):
        c.setLineWidth(1)
        c.setStrokeColor(colors.black)

        header_y = self.page_height - self.margin - self.header_height
        c.rect(self.margin, header_y, self.body_width, self.header_height, stroke=1, fill=0)

        body_y = self.margin + self.footer_height
        c.rect(self.margin, body_y, self.body_width, self.body_height, stroke=1, fill=0)

        if self.layout == "2up":
            center_x = self.margin + self.body_width / 2
            c.line(center_x, body_y, center_x, body_y + self.body_height)

        c.rect(self.margin, self.margin, self.body_width, self.footer_height, stroke=1, fill=0)

    def _draw_column(self, c, lines, start_idx, count, x, y):
        c.setFillColor(colors.black)
        c.setFont(self.font_name, self.font_size)
        for i in range(count):
            if start_idx + i >= len(lines):
                break
            text_y = y - (i + 1) * self.leading + (self.leading - self.font_size) / 2
            for x_off, text in lines[start_idx + i]:
                if text:
                    c.drawString(x + self.padding_left + x_off, text_y, text)

    def _draw_header(self, c, filename):
        header_y = self.page_height - self.margin - self.header_height
        c.setFillColor(colors.lightgrey)
        c.rect(
            self.margin,
            header_y,
            self.body_width,
            self.header_height,
            stroke=1,
            fill=1,
        )
        c.setFillColor(colors.black)

        info_size = 10
        name_size = 13
        date_str = self.timestamp.strftime("%Y-%m-%d %H:%M:%S")
        info_str = "Updated {}  Printed by {}".format(date_str, self.user)
        left_x = self.margin + 5
        right_edge = self.page_width - self.margin - 5
        info_width = pdfmetrics.stringWidth(info_str, self.font_name, info_size)
        info_x = right_edge - info_width
        visible_name = fit_text(
            filename,
            self.font_name,
            name_size,
            info_x - 6 - left_x,
        )

        c.setFont(self.font_name, name_size)
        c.drawString(left_x, header_y + 4, visible_name)
        c.setFont(self.font_name, info_size)
        c.drawString(info_x, header_y + 5, info_str)

    def _draw_footer(self, c, page_num, total_pages, full_path):
        footer_y = self.margin
        c.setFillColor(colors.black)
        footer_size = 10
        page_str = "{} / {}".format(page_num, total_pages)
        left_x = self.margin + 5
        right_edge = self.page_width - self.margin - 5
        page_width = pdfmetrics.stringWidth(page_str, self.font_name, footer_size)
        page_x = right_edge - page_width
        visible_path = fit_text(
            full_path,
            self.font_name,
            footer_size,
            page_x - 6 - left_x,
        )
        c.setFont(self.font_name, footer_size)
        c.drawString(left_x, footer_y + 4, visible_path)
        c.drawString(page_x, footer_y + 4, page_str)


NAMED_FONT_SIZES = {
    "large": 11,
    "medium": 10,
    "small": 8,
}
MIN_FONT_SIZE = 6
MAX_FONT_SIZE = 16


def parse_font_size(value):
    """Accept large/medium/small or an integer from 6 to 16."""
    if value in NAMED_FONT_SIZES:
        return NAMED_FONT_SIZES[value]
    if not value.isdigit():
        raise argparse.ArgumentTypeError(
            "invalid font size: {!r} (use large, medium, small, or an integer from {} to {})".format(
                value, MIN_FONT_SIZE, MAX_FONT_SIZE
            )
        )
    size = int(value)
    if size < MIN_FONT_SIZE or size > MAX_FONT_SIZE:
        raise argparse.ArgumentTypeError(
            "font size must be an integer from {} to {} (got {})".format(
                MIN_FONT_SIZE, MAX_FONT_SIZE, size
            )
        )
    return size


def default_output_path(input_path):
    """Replace the input suffix with .pdf in the same directory."""
    base, _ext = os.path.splitext(input_path)
    return base + ".pdf"


def build_parser():
    parser = argparse.ArgumentParser(
        description=(
            "Convert a text file to an A4 PDF. "
            "Japanese and ASCII are drawn with an embedded IPA Gothic font."
        )
    )
    parser.add_argument("input_file", help="Path to the input text file")
    parser.add_argument("output_file", nargs="?", help="Path to the output PDF file")
    parser.add_argument(
        "--font-size",
        type=parse_font_size,
        default=NAMED_FONT_SIZES["medium"],
        help=(
            "Body font size: large (11pt), medium (10pt, default), small (8pt), "
            "or an integer from 6 to 16. Header and footer sizes stay fixed."
        ),
    )
    parser.add_argument(
        "--layout",
        choices=["2up", "1up"],
        default="2up",
        help="Layout (2up=Landscape 2 columns, 1up=Portrait 1 column)",
    )
    parser.add_argument(
        "--encoding",
        default=DEFAULT_ENCODING,
        help=(
            "Input encoding: auto (default), euc_jis_2004, euc_jp, utf-8, or cp932. "
            "Hyphenated names such as euc-jp and euc-jis-2004 are also accepted."
        ),
    )
    parser.add_argument(
        "--font-path",
        help=(
            "TrueType font to embed. When omitted, ipag.ttf is taken from the "
            "standard font directories and their subdirectories."
        ),
    )
    parser.add_argument(
        "--tab-size",
        type=int,
        default=8,
        help="Tab stop width in ASCII spaces (default: 8)",
    )
    return parser


def main(argv=None):
    parser = build_parser()
    args = parser.parse_args(argv)
    if args.tab_size < 1:
        parser.error("--tab-size must be an integer >= 1")

    input_path = args.input_file
    if not os.path.exists(input_path):
        print("Error: File not found: {}".format(input_path), file=sys.stderr)
        return 1
    if os.path.isdir(input_path):
        print("Error: Input path is a directory: {}".format(input_path), file=sys.stderr)
        return 1

    if args.output_file:
        output_path = args.output_file
    else:
        output_path = default_output_path(input_path)

    try:
        converter = TextToPdfConverter(
            font_size=args.font_size,
            layout=args.layout,
            font_path=args.font_path,
            tab_size=args.tab_size,
        )
        converter.convert(input_path, output_path, encoding=args.encoding)
    except ConversionError as exc:
        print(str(exc), file=sys.stderr)
        return exc.exit_code
    except OSError as exc:
        print("Error: {}".format(exc), file=sys.stderr)
        return 1
    return 0


