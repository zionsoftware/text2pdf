#!/usr/bin/env python3
import argparse
import os
import sys

from converter import (
    DEFAULT_ENCODING,
    DEFAULT_FONT_PATH,
    ConversionError,
    TextToPdfConverter,
)


def build_parser():
    parser = argparse.ArgumentParser(
        description=(
            "Convert a text file to an A4 PDF. "
            "Japanese and ASCII are drawn with an embedded IPA Gothic font."
        )
    )
    parser.add_argument("input_file", help="Path to the input text file")
    parser.add_argument("output_file", nargs="?", help="Path to the output PDF file")
    parser.add_argument(
        "--font-size",
        choices=["large", "medium", "small"],
        default="medium",
        help="Font size (large=11pt, medium=10pt, small=8pt)",
    )
    parser.add_argument(
        "--layout",
        choices=["2up", "1up"],
        default="2up",
        help="Layout (2up=Landscape 2 columns, 1up=Portrait 1 column)",
    )
    parser.add_argument(
        "--encoding",
        default=DEFAULT_ENCODING,
        help=(
            "Input encoding: euc_jis_2004 (default), euc_jp, or utf-8. "
            "Hyphenated names such as euc-jp and euc-jis-2004 are also accepted."
        ),
    )
    parser.add_argument(
        "--font-path",
        default=DEFAULT_FONT_PATH,
        help="TrueType font to embed (default: ~/.local/share/fonts/ipag.ttf)",
    )
    parser.add_argument(
        "--tab-size",
        type=int,
        default=8,
        help="Tab stop width in ASCII spaces (default: 8)",
    )
    return parser


def main(argv=None):
    parser = build_parser()
    args = parser.parse_args(argv)
    if args.tab_size < 1:
        parser.error("--tab-size must be an integer >= 1")

    input_path = args.input_file
    if not os.path.exists(input_path):
        print("Error: File not found: {}".format(input_path), file=sys.stderr)
        return 1
    if os.path.isdir(input_path):
        print("Error: Input path is a directory: {}".format(input_path), file=sys.stderr)
        return 1

    if args.output_file:
        output_path = args.output_file
    else:
        base, _ = os.path.splitext(input_path)
        output_path = base + ".pdf"

    size_map = {
        "large": 11,
        "medium": 10,
        "small": 8,
    }
    try:
        converter = TextToPdfConverter(
            font_size=size_map[args.font_size],
            layout=args.layout,
            font_path=args.font_path,
            tab_size=args.tab_size,
        )
        converter.convert(input_path, output_path, encoding=args.encoding)
    except ConversionError as exc:
        print(str(exc), file=sys.stderr)
        return exc.exit_code
    except OSError as exc:
        print("Error: {}".format(exc), file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
